# Get the partition separator for a device node
# (the part, if any, between the device node's name
# and the partition number in /dev -- e.g.
# "p" for /dev/nvme0n1 (1st partition = /dev/nvme0n1p1)
# or
# "" for /dev/sda (1st partition = /dev/sda1)
partitionSeparator() {
	if [[ "$(basename $1)" =~ (sd|hd|vd)[a-z] ]]; then
		echo ""
	else
		echo "p"
	fi
}

# Rescan the partition table, and make sure any device nodes
# for newly created partitions are created
rescanPartitions () {
	local i
	local SEPARATOR="$(partitionSeparator $1)"

	sync
	udevadm settle -t 5
	partx -a $1 || :

	TRIES=0
	while ! partx -u $1 ; do
		# This happens in abf (and possibly other containers)?
		# Got to find out what's going on here...
		echo "WARNING: partition rescan failed. This should not happen outside of ABF."
		sleep 5s
		TRIES=$((TRIES+1))
		if [ "$TRIES" = 10 ]; then
			echo "ERROR: partition rescan on $1 still failing after $TRIES attempts. Giving up."
			exit 1
		fi
	done

	udevadm settle -t 5 &>/dev/null || :
	partx -a $1 || :
	partx -u $1 || :
	udevadm settle -t 5 &>/dev/null
	# Workaround for /dev/loopXpY device nodes not being created
	# inside the isobuilder container in ABF -- this shouldn't
	# run in a normal environment (but can't hurt either)
	for i in $(partx -go NR $1); do
		if ! [ -e ${1}${SEPARATOR}${i} ]; then
			local LDEV="$(basename $1)"
			local NODE="$(cat /sys/block/$LDEV/${LDEV}${SEPARATOR}${i}/dev)"
			mknod /dev/${LDEV}p${i} b ${NODE/:*/} ${NODE/*:/}
		fi
	done
}

# ---------------------------------------------------------------------------
# Partition entry format (colon-separated):
#	START:END:TYPE:FILESYSTEM:MOUNTPOINT:LABEL:ALIGNMENT:PARTNO:SUBVOL:MOUNTOPTS
#
#	START	Start of the partition (blank = start of free space)
#	END	End (or, if prefixed with +, size) of the partition
#		(blank = remainder of the disk)
#	TYPE	GPT type (e.g. 8200 = swap, 8300 = Linux, ef00 = EFI boot, ...)
#	FILESYSTEM	Filesystem (blank = reasonable default from TYPE/FSTYPE;
#			"-" = do not format;
#			iso9660 / udf / iso9660+udf = Live ISO, packed by
#			createIsoImage after the rootfs is populated)
#	MOUNTPOINT	Where to mount in the target hierarchy
#	LABEL	Partition / filesystem label
#	ALIGNMENT	sgdisk -a value (use 1 for non-standard starts)
#	PARTNO	Partition number (blank = array index + 1 for real partitions;
#			for subvolume-only entries, blank = previous real PARTNO)
#	SUBVOL	btrfs subvolume to create and mount (see below)
#	MOUNTOPTS	Extra mount/fstab options (comma-separated), beyond defaults
#
# Fields at the end that should remain blank/default can simply be omitted.
#
# Subvolume-only entries (additional mounts on an existing btrfs partition):
#	Leave START, END and TYPE empty and either set PARTNO to the existing
#	partition number or omit it to reuse the previous real partition, e.g.:
#	  PARTITIONS+=("::8304:btrfs:/:OMVROOT:::@")
#	  PARTITIONS+=("::::/home::::@home")
#
# Live DVD / ISO (no GPT disk; packed by createIsoImage):
#	  PARTITIONS=(":::iso9660+udf:/:OMVLIVE")
#
# btrfs subvolumes:
#	If FILESYSTEM resolves to btrfs (or the entry is subvolume-only) and
#	SUBVOL is omitted, a conventional name is chosen:
#	  /       -> @
#	  /home   -> @home
#	  /srv    -> @srv
#	  /var/log -> @var/log
#	Set SUBVOL=- to use the top-level volume (no named subvolume).
#	For root-on-subvolume, the subvolume is also set as the btrfs default
#	so the kernel can mount it via root= without rootflags/dracut fstab.
# ---------------------------------------------------------------------------

# Field from a partition entry (1-based, like cut -f)
partitionEntryField() {
	echo "$1" | cut -d: -f"$2"
}

# Replace field N (1-based) in a colon-separated partition entry
replacePartitionEntryField() {
	local entry="$1"
	local field="$2"
	local value="$3"
	local -a f
	local i out
	IFS=: read -ra f <<< "$entry"
	while [ ${#f[@]} -lt "$field" ]; do
		f+=("")
	done
	f[$((field-1))]="$value"
	out="${f[0]}"
	for ((i=1; i<${#f[@]}; i++)); do
		out="${out}:${f[$i]}"
	done
	printf '%s\n' "$out"
}

# Parse a size (10G, 512M, 20GiB, 20480, +10G) to bytes.
# Units are binary (1024) to match sgdisk. A bare number is GiB.
parseSizeToBytes() {
	local s n unit
	s="${1#+}"
	s="${s// /}"
	if [[ "$s" =~ ^([0-9]+)([KkMmGgTt])([iI][bB])?$ ]]; then
		n="${BASH_REMATCH[1]}"
		unit="${BASH_REMATCH[2]}"
	elif [[ "$s" =~ ^([0-9]+)([KkMmGgTt])[bB]$ ]]; then
		n="${BASH_REMATCH[1]}"
		unit="${BASH_REMATCH[2]}"
	elif [[ "$s" =~ ^([0-9]+)$ ]]; then
		n="${BASH_REMATCH[1]}"
		unit="G"
	else
		echo "Invalid size '$1' (examples: 20G, 20480M)" >&2
		return 1
	fi
	case "$unit" in
	K|k) echo $((n * 1024)) ;;
	M|m) echo $((n * 1024 * 1024)) ;;
	G|g) echo $((n * 1024 * 1024 * 1024)) ;;
	T|t) echo $((n * 1024 * 1024 * 1024 * 1024)) ;;
	esac
}

# sgdisk-style +SIZE for a byte count (rounds up to the next MiB if needed)
formatSizeForSgdisk() {
	local b="$1"
	if [ $((b % (1024*1024*1024))) -eq 0 ]; then
		echo "+$((b / 1024 / 1024 / 1024))G"
	elif [ $((b % (1024*1024))) -eq 0 ]; then
		echo "+$((b / 1024 / 1024))M"
	else
		echo "+$(( (b + 1048575) / 1048576 ))M"
	fi
}

# Bytes consumed by a START:END spec. Empty if END is blank (remainder of disk).
partitionSpecSizeBytes() {
	local start="$1"
	local end="$2"
	if [ -z "$end" ]; then
		echo ""
		return 0
	fi
	if [[ "$end" == +* ]]; then
		parseSizeToBytes "$end"
		return
	fi
	if [[ "$end" =~ ^[0-9]+$ ]] && [[ "$start" =~ ^[0-9]+$ ]]; then
		echo $(( (end - start + 1) * 512 ))
		return 0
	fi
	echo ""
}

# Print the index of the first entry mounted at MP.
# With "real" as $3, skip subvolume-only entries. Returns 1 if not found.
findMountIndex() {
	local PARRAY=$1[@]
	local PARTS=("${!PARRAY}")
	local mp="$2"
	local i
	for i in "${!PARTS[@]}"; do
		[ "$(partitionEntryField "${PARTS[$i]}" 5)" = "$mp" ] || continue
		if [ "$3" = "real" ] && isSubvolumeOnlyEntry "${PARTS[$i]}"; then
			continue
		fi
		echo "$i"
		return 0
	done
	return 1
}

# Approximate bytes left for a remainder partition (skip_idx) on IMAGE.
remainderBytes() {
	local PARRAY=$1[@]
	local PARTS=("${!PARRAY}")
	local image="$2"
	local skip_idx="$3"
	local slack=67108864
	local img_sz reserved i s e psz rem
	img_sz="$(stat -c%s "$image")"
	reserved=$slack
	for i in "${!PARTS[@]}"; do
		[ "$i" = "$skip_idx" ] && continue
		isSubvolumeOnlyEntry "${PARTS[$i]}" && continue
		s="$(partitionEntryField "${PARTS[$i]}" 1)"
		e="$(partitionEntryField "${PARTS[$i]}" 2)"
		psz="$(partitionSpecSizeBytes "$s" "$e")"
		[ -n "$psz" ] && reserved=$((reserved + psz))
	done
	rem=$((img_sz - reserved))
	[ "$rem" -lt 0 ] && rem=0
	echo "$rem"
}

growImageBy() {
	local image="$1"
	local delta="$2"
	local why="$3"
	local img_sz newsz
	[ "$delta" -ge 1048576 ] || return 0
	img_sz="$(stat -c%s "$image")"
	newsz=$((img_sz + delta))
	echo "Growing image by $((delta / 1024 / 1024)) MiB${why:+ so ${why}}"
	truncate -s "$newsz" "$image"
}

# Index of the real partition that owns this entry (walks back from a
# subvolume-only line to the underlying partition).
owningPartitionIndex() {
	local PARRAY=$1[@]
	local PARTS=("${!PARRAY}")
	local idx="$2"
	local i
	if ! isSubvolumeOnlyEntry "${PARTS[$idx]}"; then
		echo "$idx"
		return 0
	fi
	for ((i=idx; i>=0; i--)); do
		if ! isSubvolumeOnlyEntry "${PARTS[$i]}"; then
			echo "$i"
			return 0
		fi
	done
	echo "$idx"
}

# A PARTITIONS entry for a dedicated /home (START blank).
# $1 = END spec: +20G for a fixed size, empty for remainder of disk.
homePartitionEntry() {
	local end="$1"
	local fs="${FSTYPE:-ext4}"
	if [ "$fs" = "btrfs" ]; then
		echo ":${end}:8302:btrfs:/home:HOME:::@home"
	else
		echo ":${end}:8302:${fs}:/home:HOME"
	fi
}

# Grow the partition mounted at MP (and the image) so it is at least MINSIZE.
# MP must already exist as a real partition (not only a subvolume of another FS).
#
# Usage: applyMountMinSize ARRAYNAME IMAGE MOUNTPOINT MINSIZE
applyMountMinSize() {
	local aname="$1"
	local image="$2"
	local mp="$3"
	local minsize="$4"
	local -n _MP="$aname"
	local min_bytes current delta
	local idx="" parent start end newend

	[ -z "$minsize" ] && return 0
	[ "${#_MP[@]}" -gt 0 ] || return 0
	isIsoImage "$aname" && return 0
	[ -n "$image" ] && [ -e "$image" ] || return 0

	min_bytes="$(parseSizeToBytes "$minsize")" || return 1

	idx="$(findMountIndex "$aname" "$mp")" || idx=""
	if [ -z "$idx" ]; then
		echo "WARNING: minimum ${mp} size ${minsize} ignored (no ${mp} partition)" >&2
		return 0
	fi

	parent="$(owningPartitionIndex "$aname" "$idx")"
	start="$(partitionEntryField "${_MP[$parent]}" 1)"
	end="$(partitionEntryField "${_MP[$parent]}" 2)"

	if [[ "$end" == +* ]]; then
		current="$(parseSizeToBytes "$end")"
		if [ "$current" -ge "$min_bytes" ]; then
			echo "${mp} partition already ${end#+} (>= ${minsize}); leaving as-is"
			return 0
		fi
		newend="$(formatSizeForSgdisk "$min_bytes")"
		echo "Raising ${mp} from ${end} to ${newend} (minimum ${minsize})"
		_MP[$parent]="$(replacePartitionEntryField "${_MP[$parent]}" 2 "$newend")"
		growImageBy "$image" $((min_bytes - current)) "the last partition keeps its free space"
		return 0
	fi

	if [ -z "$end" ]; then
		current="$(remainderBytes "$aname" "$image" "$parent")"
		if [ "$current" -ge "$min_bytes" ]; then
			echo "${mp} (last partition) already has room (>= ${minsize}); leaving image size as-is"
			return 0
		fi
		growImageBy "$image" $((min_bytes - current)) "${mp} is at least ${minsize}"
		return 0
	fi

	current="$(partitionSpecSizeBytes "$start" "$end")"
	if [ -n "$current" ] && [ "$current" -lt "$min_bytes" ]; then
		echo "ERROR: ${mp} is a fixed sector range (${start}:${end}) smaller than ${minsize}; cannot resize automatically" >&2
		return 1
	fi
}

# Grow / (and the image file) so the root filesystem is at least MINSIZE.
# The last partition still consumes any remaining disk (typically /home or /srv).
#
# Usage: applyRootMinSize ARRAYNAME IMAGE MINSIZE
applyRootMinSize() {
	applyMountMinSize "$1" "$2" / "$3"
}

# Make sure a real /home partition exists, then apply the minimum size.
# Layouts that only have / (or /home as a btrfs subvolume of /) get a new
# /home partition: if / currently takes the rest of the disk it is given a
# fixed size and /home becomes the growable last partition; if something
# else (e.g. /srv) is already last, /home is inserted as a fixed-size
# partition so that last partition still grows.
#
# Usage: applyHomeMinSize ARRAYNAME IMAGE MINSIZE
applyHomeMinSize() {
	local aname="$1"
	local image="$2"
	local minsize="$3"
	local -n _HP="$aname"
	local min_bytes idx parent end current newend insert_at
	local home_entry

	[ -z "$minsize" ] && return 0
	[ "${#_HP[@]}" -gt 0 ] || return 0
	isIsoImage "$aname" && return 0
	[ -n "$image" ] && [ -e "$image" ] || return 0

	min_bytes="$(parseSizeToBytes "$minsize")" || return 1

	# A subvolume-only /home shares / — drop it so we can add a real partition.
	idx="$(findMountIndex "$aname" /home)" || idx=""
	if [ -n "$idx" ] && isSubvolumeOnlyEntry "${_HP[$idx]}"; then
		echo "Replacing /home subvolume with a dedicated /home partition"
		_HP=("${_HP[@]:0:idx}" "${_HP[@]:idx+1}")
		idx=""
	fi

	if [ -z "$idx" ]; then
		idx="$(findMountIndex "$aname" /home real)" || idx=""
	fi

	if [ -z "$idx" ]; then
		idx="$(findMountIndex "$aname" /)" || idx=""
		if [ -z "$idx" ]; then
			echo "WARNING: -H ${minsize} ignored (no / partition to place /home after)" >&2
			return 0
		fi
		parent="$(owningPartitionIndex "$aname" "$idx")"
		end="$(partitionEntryField "${_HP[$parent]}" 2)"

		insert_at=$((parent + 1))
		while [ "$insert_at" -lt "${#_HP[@]}" ] && isSubvolumeOnlyEntry "${_HP[$insert_at]}"; do
			insert_at=$((insert_at + 1))
		done

		if [ -z "$end" ]; then
			# / is the growable last partition — freeze its current size
			# and let the new /home take the remainder.
			current="$(remainderBytes "$aname" "$image" "$parent")"
			[ "$current" -lt 1048576 ] && current=1048576
			newend="$(formatSizeForSgdisk "$current")"
			echo "Giving / a fixed size of ${newend} so /home can take the rest of the disk"
			_HP[$parent]="$(replacePartitionEntryField "${_HP[$parent]}" 2 "$newend")"
			home_entry="$(homePartitionEntry "")"
			echo "Adding /home as last partition (${minsize}, ${FSTYPE:-ext4})"
		else
			# Something else already grows to fill the disk; insert a
			# fixed-size /home so we do not steal that leftover.
			home_entry="$(homePartitionEntry "$(formatSizeForSgdisk "$min_bytes")")"
			echo "Adding /home partition (${minsize}, ${FSTYPE:-ext4})"
		fi

		_HP=("${_HP[@]:0:insert_at}" "$home_entry" "${_HP[@]:insert_at}")
		if [ -z "$end" ]; then
			growImageBy "$image" "$min_bytes" "/home is at least ${minsize}"
		else
			growImageBy "$image" "$min_bytes" "the last partition keeps its free space"
		fi
	fi

	applyMountMinSize "$aname" "$image" /home "$minsize"
}

# True if this entry only adds a mount/subvolume on an existing partition
# (START, END and TYPE are all empty). ISO-family entries use the same
# empty geometry fields but are not subvolumes.
isSubvolumeOnlyEntry() {
	local fs
	fs="$(partitionEntryField "$1" 4)"
	isIsoFilesystem "$fs" && return 1
	[ -z "$(partitionEntryField "$1" 1)" ] && \
	[ -z "$(partitionEntryField "$1" 2)" ] && \
	[ -z "$(partitionEntryField "$1" 3)" ]
}

# Resolve filesystem name for an entry (may be empty for unformatted /
# subvolume-only lines). Uses global FSTYPE when TYPE implies a Linux FS.
resolveFilesystem() {
	local entry="$1"
	local fs="$(partitionEntryField "$entry" 4)"
	if [ "$fs" = "-" ]; then
		echo ""
		return
	fi
	if [ -n "$fs" ]; then
		echo "$fs"
		return
	fi
	if isSubvolumeOnlyEntry "$entry"; then
		# Additional mount on an existing filesystem — assume btrfs
		# (the only FS where multi-mount entries make sense here).
		echo "btrfs"
		return
	fi
	local type="$(partitionEntryField "$entry" 3)"
	case $type in
	ef00)
		echo vfat
		;;
	ef02)
		echo ""
		;;
	8200)
		echo swap
		;;
	*)
		echo "${FSTYPE}"
		;;
	esac
}

# True if FILESYSTEM is an ISO-family image (iso9660, udf, or both).
# Those are packed with xorriso after the rootfs is populated -- they
# are not GPT partitions created by partitionDisk.
isIsoFilesystem() {
	local fs
	fs="$(echo "$1" |tr 'A-Z' 'a-z')"
	case "$fs" in
	iso9660*|udf*|iso9660+udf|udf+iso9660|*iso9660*|*udf*)
		return 0
		;;
	esac
	return 1
}

# True if any entry in the named PARTITIONS array is an ISO-family image.
isIsoImage() {
	local PARRAY=$1[@]
	local PARTITIONS=("${!PARRAY}")
	local i fs
	[ "${#PARTITIONS[@]}" -gt 0 ] || return 1
	for i in "${!PARTITIONS[@]}"; do
		fs="$(resolveFilesystem "${PARTITIONS[$i]}")"
		if isIsoFilesystem "$fs"; then
			return 0
		fi
	done
	return 1
}

# Default subvolume name for a mount point (@, @home, @var/log, ...)
defaultSubvolumeForMountpoint() {
	local mp="$1"
	if [ -z "$mp" ]; then
		echo ""
	elif [ "$mp" = "/" ]; then
		echo "@"
	else
		echo "@${mp#/}"
	fi
}

# Resolve subvolume name: explicit SUBVOL, "-" = none, empty = default for btrfs
resolveSubvolume() {
	local entry="$1"
	local fs="$2"
	local mp="$3"
	local subvol="$(partitionEntryField "$entry" 9)"

	if [ "$subvol" = "-" ]; then
		echo ""
		return
	fi
	if [ -n "$subvol" ]; then
		echo "$subvol"
		return
	fi
	if [ "$fs" = "btrfs" ] && [ -n "$mp" ]; then
		defaultSubvolumeForMountpoint "$mp"
		return
	fi
	echo ""
}

# Mount/fstab options: defaults[,subvol=...][,MOUNTOPTS]
resolveMountOptions() {
	local entry="$1"
	local fs="$2"
	local mp="$3"
	local subvol="$(resolveSubvolume "$entry" "$fs" "$mp")"
	local extra="$(partitionEntryField "$entry" 10)"
	local opts="defaults"

	[ -n "$subvol" ] && opts="${opts},subvol=${subvol}"
	[ -n "$extra" ] && opts="${opts},${extra}"
	echo "$opts"
}

# Populate RESOLVED_PARTNOS[i] for each entry in the named PARTITIONS array.
# Real partitions: explicit PARTNO or (array index + 1).
# Subvolume-only entries: explicit PARTNO or the previous real partition's number.
resolvePartitionNumbers() {
	local PARRAY=$1[@]
	local PARTITIONS=("${!PARRAY}")
	local i
	local partno
	local last_partno=""

	RESOLVED_PARTNOS=()
	for i in "${!PARTITIONS[@]}"; do
		partno="$(partitionEntryField "${PARTITIONS[$i]}" 8)"
		if isSubvolumeOnlyEntry "${PARTITIONS[$i]}"; then
			if [ -z "$partno" ]; then
				partno="$last_partno"
			fi
			if [ -z "$partno" ]; then
				echo "ERROR: subvolume-only partition entry #$((i+1)) has no PARTNO and no previous partition" >&2
				return 1
			fi
		else
			if [ -z "$partno" ]; then
				partno=$((i+1))
			fi
			last_partno="$partno"
		fi
		RESOLVED_PARTNOS[$i]="$partno"
	done
}

# Partition and format a disk
#
# Usage:
#	partitionDisk DEVICE PARTITIONS
#	DEVICE: Device file on which partitions will be created, e.g. /dev/sda, /dev/mmcblk0
#	PARTITIONS: Name of an array containing the partition table (see format above)
#
#	MOUNTPOINT / SUBVOL / MOUNTOPTS are ignored by this function; they are
#	used by mountAll and fstab generation so the same array can be shared.
#
# Example:
#	PARTITIONS=(":+256M:ef00::/boot/efi:EFIBoot")
#	PARTITIONS+=(":+1G:8200")
#	PARTITIONS+=(":+50G:8305:btrfs:/:root:::@")
#	PARTITIONS+=("::::/home::::@home")
#	partitionDisk /dev/sda PARTITIONS
#
partitionDisk() {
	local DESTINATION="$1"
	local PARRAY=$2[@]
	local PARTITIONS=("${!PARRAY}")
	local SEPARATOR="$(partitionSeparator $1)"
	local MKFS
	local i
	local PARTNO
	local TYPE
	local LABEL
	local ALIGN
	local FS
	local MKFSARGS
	local FORMATTED=""

	resolvePartitionNumbers "$2" || return 1

	local SGDISK_ARGS="--zap-all"
	for i in ${!PARTITIONS[@]}; do
		if isSubvolumeOnlyEntry "${PARTITIONS[$i]}"; then
			continue
		fi
		if isIsoFilesystem "$(resolveFilesystem "${PARTITIONS[$i]}")"; then
			continue
		fi
		PARTNO="${RESOLVED_PARTNOS[$i]}"
		TYPE="$(partitionEntryField "${PARTITIONS[$i]}" 3)"
		LABEL="$(partitionEntryField "${PARTITIONS[$i]}" 6)"
		ALIGN="$(partitionEntryField "${PARTITIONS[$i]}" 7)"
		[ -n "$ALIGN" ] && SGDISK_ARGS="${SGDISK_ARGS} -a ${ALIGN}"
		SGDISK_ARGS="${SGDISK_ARGS} -n ${PARTNO}:$(echo ${PARTITIONS[$i]} |cut -d: -f1-2)"
		# Return to default alignment for subsequent partitions
		[ -n "$ALIGN" ] && SGDISK_ARGS="${SGDISK_ARGS} -a 2048"
		if [ -n "$TYPE" ]; then
			SGDISK_ARGS="${SGDISK_ARGS} -t ${PARTNO}:${TYPE}"
			[ "$TYPE" = "ef00" ] && SGDISK_ARGS="$SGDISK_ARGS -A ${PARTNO}:set:0"
		fi
		if [ -n "$LABEL" ]; then
			SGDISK_ARGS="${SGDISK_ARGS} -c ${PARTNO}:${LABEL}"
		fi
	done
	sgdisk $SGDISK_ARGS $DESTINATION
	sync
	rescanPartitions $DESTINATION
	for i in ${!PARTITIONS[@]}; do
		if isSubvolumeOnlyEntry "${PARTITIONS[$i]}"; then
			continue
		fi
		if isIsoFilesystem "$(resolveFilesystem "${PARTITIONS[$i]}")"; then
			continue
		fi
		PARTNO="${RESOLVED_PARTNOS[$i]}"
		# Only format each partition once (multi-subvol shares one PARTNO)
		case " ${FORMATTED} " in
		*" ${PARTNO} "*) continue ;;
		esac
		FS="$(partitionEntryField "${PARTITIONS[$i]}" 4)"
		[ "$FS" = "-" ] && continue
		FS="$(resolveFilesystem "${PARTITIONS[$i]}")"
		[ -z "$FS" ] && continue
		LABEL="$(partitionEntryField "${PARTITIONS[$i]}" 6)"
		MKFSARGS=""
		case $FS in
		*fat*)
			MKFS=mkfs.vfat
			[ -n "$LABEL" ] && MKFSARGS="$MKFSARGS -n ${LABEL}"
			;;
		*)
			[ "$FS" = "swap" ] && MKFS=mkswap || MKFS=mkfs.$FS
			[ -n "$LABEL" ] && MKFSARGS="$MKFSARGS -L ${LABEL}"
			;;
		esac
		wipefs -a ${DESTINATION}${SEPARATOR}${PARTNO}
		$MKFS $MKFSARGS ${DESTINATION}${SEPARATOR}${PARTNO}
		FORMATTED="${FORMATTED} ${PARTNO}"
	done
}

# Create btrfs subvolumes for all entries that need them (top-level mount).
# Also sets the default subvolume when / lives on a named subvolume so the
# kernel can mount root without rootflags.
prepareBtrfsSubvolumes() {
	local DEVNODE="$1"	# full device node including separator prefix, e.g. /dev/sda or /dev/loop0p
	local PARRAY=$2[@]
	local PARTITIONS=("${!PARRAY}")
	local i j
	local PARTNO FS MP SUBVOL
	local TMP
	local PREPARED=""
	local NEED_DEFAULT
	local DEFAULT_PATH

	for i in "${!PARTITIONS[@]}"; do
		PARTNO="${RESOLVED_PARTNOS[$i]}"
		FS="$(resolveFilesystem "${PARTITIONS[$i]}")"
		[ "$FS" = "btrfs" ] || continue
		MP="$(partitionEntryField "${PARTITIONS[$i]}" 5)"
		SUBVOL="$(resolveSubvolume "${PARTITIONS[$i]}" "$FS" "$MP")"
		# Still prepare the FS if we might set-default even without named subvols? No.
		case " ${PREPARED} " in
		*" ${PARTNO} "*) continue ;;
		esac

		# Any named subvolume on this partition?
		local ANY=0
		NEED_DEFAULT=""
		DEFAULT_PATH=""
		for j in "${!PARTITIONS[@]}"; do
			[ "${RESOLVED_PARTNOS[$j]}" = "$PARTNO" ] || continue
			local jfs jmp jsub
			jfs="$(resolveFilesystem "${PARTITIONS[$j]}")"
			[ "$jfs" = "btrfs" ] || continue
			jmp="$(partitionEntryField "${PARTITIONS[$j]}" 5)"
			jsub="$(resolveSubvolume "${PARTITIONS[$j]}" "$jfs" "$jmp")"
			if [ -n "$jsub" ]; then
				ANY=1
				if [ "$jmp" = "/" ]; then
					NEED_DEFAULT=1
					DEFAULT_PATH="$jsub"
				fi
			fi
		done
		[ "$ANY" = "1" ] || continue

		TMP="$(mktemp -d "${TMPDIR:-/var/tmp}/btrfs-subvol-XXXXXX")"
		mount "${DEVNODE}${PARTNO}" "$TMP"
		for j in "${!PARTITIONS[@]}"; do
			[ "${RESOLVED_PARTNOS[$j]}" = "$PARTNO" ] || continue
			local jfs jmp jsub jparent
			jfs="$(resolveFilesystem "${PARTITIONS[$j]}")"
			[ "$jfs" = "btrfs" ] || continue
			jmp="$(partitionEntryField "${PARTITIONS[$j]}" 5)"
			jsub="$(resolveSubvolume "${PARTITIONS[$j]}" "$jfs" "$jmp")"
			[ -n "$jsub" ] || continue
			if [ ! -e "${TMP}/${jsub}" ]; then
				jparent="$(dirname "${TMP}/${jsub}")"
				mkdir -p "$jparent"
				btrfs subvolume create "${TMP}/${jsub}"
			fi
		done
		if [ -n "$NEED_DEFAULT" ] && [ -n "$DEFAULT_PATH" ]; then
			btrfs subvolume set-default "${TMP}/${DEFAULT_PATH}"
		fi
		umount "$TMP"
		rmdir "$TMP"
		PREPARED="${PREPARED} ${PARTNO}"
	done
}

# Mount all partitions on a device under a given mount point
#
# This mounts all given partitions on a device (using the same
# format passed to partitionDisk -- e.g. to mount a destination
# filesystem hierarchy after it has been created with partitionDisk)
#
# We have to mount all generated partitions at the right
# locations, which also means getting the order right
# (which may not necessarily be the same as the order
# on the disk because of nested mounts -- e.g. / has
# to be mounted before /boot, /boot has to be mounted
# before /boot/efi, ...
#
# So the order in which to try mounting partitions is
# shortest mount point to longest mount point
#
# Usage:
# 	mountAll DEVICE PARTITIONS MOUNTPOINT
#
mountAll() {
	local DEVBASE="$1"
	local SEPARATOR="$(partitionSeparator $1)"
	local DEVICE="${DEVBASE}${SEPARATOR}"
	local PARRAY=$2[@]
	local PARTITIONS=("${!PARRAY}")
	local MOUNTPOINT="$3"
	local MOUNTS
	local MP
	local MPLEN
	local PARTNO
	local FS
	local SUBVOL
	local OPTS
	local i

	resolvePartitionNumbers "$2" || return 1
	prepareBtrfsSubvolumes "${DEVICE}" "$2"

	MOUNTS=$(for i in "${!PARTITIONS[@]}"; do
		MP="$(partitionEntryField "${PARTITIONS[$i]}" 5)"
		MPLEN="$(echo $MP |wc -c)"
		echo $MPLEN.$i
	done |sort -V |cut -d. -f2)
	for i in $MOUNTS; do
		PARTNO="${RESOLVED_PARTNOS[$i]}"
		MP="$(partitionEntryField "${PARTITIONS[$i]}" 5)"
		if [ -n "$MP" ]; then
			FS="$(resolveFilesystem "${PARTITIONS[$i]}")"
			OPTS="$(resolveMountOptions "${PARTITIONS[$i]}" "$FS" "$MP")"
			mkdir -p "${MOUNTPOINT}${MP}"
			mount -o "${OPTS}" ${DEVICE}${PARTNO} "${MOUNTPOINT}${MP}"
		fi
	done
}

# Unmount a mount point and all mountpoints inside it
# Usage:
# 	umountAll /mountpoint
#
umountAll() {
	while cat /proc/mounts |grep -q "$1"; do
		umount -Rq $(cat /proc/mounts |grep "$1" |head -n1 |awk '{print $2;}')
	done
}

# Pack a populated root directory into an iso9660 and/or UDF image.
#
# Usage:
#	createIsoImage OUTPUT.iso PARTITIONS ROOTDIR
#
# FILESYSTEM on the first ISO-family entry selects the on-disc formats:
#	iso9660		Rock Ridge + Joliet ISO 9660
#	udf		UDF only
#	iso9660+udf	both (traditional Live DVD)
# LABEL becomes the volume id.
#
# Optional boot files, if present under ROOTDIR, are wired up:
#	/boot/grub/i386-pc/eltorito.img	BIOS El Torito (GRUB)
#	/boot/grub/efiboot.img		UEFI El Torito FAT image
#	/usr/lib/grub/i386-pc/boot_hybrid.img
#		used as a hybrid MBR so the ISO is also USB-bootable
#
createIsoImage() {
	local OUTPUT="$1"
	local PARRAY=$2[@]
	local PARTITIONS=("${!PARRAY}")
	local ROOTDIR="$3"
	local i fs label formats
	local XORRISO_ARGS
	local EFIBOOT=""
	local ELTORITO=""
	local HYBRIDMBR=""

	formats=""
	label="OMVLIVE"
	for i in "${!PARTITIONS[@]}"; do
		fs="$(resolveFilesystem "${PARTITIONS[$i]}")"
		if isIsoFilesystem "$fs"; then
			formats="$(echo "$fs" |tr 'A-Z' 'a-z')"
			label="$(partitionEntryField "${PARTITIONS[$i]}" 6)"
			[ -z "$label" ] && label="OMVLIVE"
			break
		fi
	done
	if [ -z "$formats" ]; then
		echo "ERROR: createIsoImage called but no iso9660/udf partition entry" >&2
		return 1
	fi

	# xorriso writes the ISO from the populated root tree.
	XORRISO_ARGS="-as mkisofs -r -l -iso-level 3 -full-iso9660-filenames"
	XORRISO_ARGS="$XORRISO_ARGS -V ${label} -A OpenMandriva -p os-image-builder"
	case "$formats" in
	udf)
		XORRISO_ARGS="$XORRISO_ARGS -udf"
		;;
	*udf*)
		XORRISO_ARGS="$XORRISO_ARGS -J -joliet-long -R -udf"
		;;
	*)
		XORRISO_ARGS="$XORRISO_ARGS -J -joliet-long -R"
		;;
	esac

	if [ -e "${ROOTDIR}/boot/grub/i386-pc/eltorito.img" ]; then
		ELTORITO="boot/grub/i386-pc/eltorito.img"
	fi
	if [ -e "${ROOTDIR}/boot/grub/efiboot.img" ]; then
		EFIBOOT="boot/grub/efiboot.img"
	fi
	if [ -e "${ROOTDIR}/usr/lib/grub/i386-pc/boot_hybrid.img" ]; then
		HYBRIDMBR="${ROOTDIR}/usr/lib/grub/i386-pc/boot_hybrid.img"
	elif [ -e /usr/lib/grub/i386-pc/boot_hybrid.img ]; then
		HYBRIDMBR=/usr/lib/grub/i386-pc/boot_hybrid.img
	fi

	if [ -n "$ELTORITO" ]; then
		XORRISO_ARGS="$XORRISO_ARGS -b ${ELTORITO} -no-emul-boot -boot-load-size 4 -boot-info-table"
		if [ -n "$HYBRIDMBR" ]; then
			XORRISO_ARGS="$XORRISO_ARGS --grub2-boot-info --grub2-mbr ${HYBRIDMBR}"
		fi
	fi
	if [ -n "$EFIBOOT" ]; then
		if [ -n "$ELTORITO" ]; then
			XORRISO_ARGS="$XORRISO_ARGS -eltorito-alt-boot"
		fi
		XORRISO_ARGS="$XORRISO_ARGS -e ${EFIBOOT} -no-emul-boot -isohybrid-gpt-basdat"
	fi

	echo "Creating ISO image ${OUTPUT} (${formats}, label ${label})"
	# shellcheck disable=SC2086
	xorriso $XORRISO_ARGS -o "$OUTPUT" "$ROOTDIR"
}
