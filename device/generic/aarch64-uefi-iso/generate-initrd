. ${OURDIR}/helpers/overlayfs-dracut
installOverlayfsDracut

sed -i -e 's,zstd,gzip,g' $OURDIR/$ROOTDIR/usr/lib/dracut/dracut.conf.d/50-dracut-distro.conf || :

chroot $OURDIR/$ROOTDIR /usr/sbin/dracut --gzip --add overlayfs \
	-o ifcfg -o lvm -o mdraid -o aufs-mount -o network -o squash \
	-o cifs -o dm -o crypt -o dmraid -o multipath -o multipath-hostonly \
	--add-drivers "overlay isofs udf" \
	-f /boot/initrd-${KERNELVERSION}.img ${KERNELVERSION}
chmod 0644 $OURDIR/$ROOTDIR/boot/initrd-${KERNELVERSION}.img
