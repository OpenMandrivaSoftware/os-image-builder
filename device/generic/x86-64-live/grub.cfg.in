search --no-floppy --label OMVLIVE --set=root
insmod part_gpt
insmod iso9660
insmod udf
insmod ext2
@IF_GUI@insmod gfxmenu
@IF_GUI@set gfxmode=auto,1680x1050,1300x768,1280x800,1024x768,1024x600,800x600,640x480
@IF_GUI@load_video
@IF_GUI@insmod gfxterm
insmod gettext
insmod gzio

set timeout_style=menu
set timeout=10

menuentry 'OpenMandriva Lx (Live)' --class openmandriva --class gnu-linux --class gnu --class os {
	linux /boot/vmlinuz-@KVERSION@ root=LABEL=OMVLIVE ro rd.live.overlay.overlayfs=1 rd.timeout=120 @CMDLINE@
	initrd /boot/initrd-@KVERSION@.img
}

@IF_GUI@menuentry 'OpenMandriva Lx (Live, text mode)' --class openmandriva --class gnu-linux --class gnu --class os {
@IF_GUI@	linux /boot/vmlinuz-@KVERSION@ root=LABEL=OMVLIVE ro rd.live.overlay.overlayfs=1 rd.timeout=120 @CMDLINE@ systemd.unit=multi-user.target
@IF_GUI@	initrd /boot/initrd-@KVERSION@.img
@IF_GUI@}

menuentry 'System setup' {
	fwsetup
}
