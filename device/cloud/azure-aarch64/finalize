# Azure wants a fixed-size VHD, aligned to 1 MiB.
MB=$((1024*1024))
RAW="${OURDIR}/${RESULTDIR}/${BASENAME}.img"
size=$(qemu-img info -f raw --output json "$RAW" | \
	gawk 'match($0, /"virtual-size": ([0-9]+),/, val) {print val[1]}')
rounded_size=$(((($size+$MB-1)/$MB)*$MB))
qemu-img resize -f raw "$RAW" $rounded_size
qemu-img convert -f raw "$RAW" -O vpc -o subformat=fixed,force_size \
	"${OURDIR}/${RESULTDIR}/${BASENAME}.vhd"
rm -f "$RAW"
