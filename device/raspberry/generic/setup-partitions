IMAGE=${OURDIR}/${RESULTDIR}/${BASENAME}.img
dd if=/dev/zero of=${IMAGE} bs=1M count=$((PADDED_EXPECTED_SIZE/1048576))

# Raspberry Pi firmware requires a FAT partition as the first one.
# GPT works with current Pi 3/4/400 firmware; type 0700 = Microsoft basic data.
PARTITIONS=(":+256M:0700:vfat:/boot:OMVBOOT")
PARTITIONS+=("::8305:${FSTYPE}:/:OMVROOT")
