[ -z "$UBOOT" ] && UBOOT="https://gitlab.denx.de/u-boot/u-boot.git"
[ -z "$UBOOT_VERSION" ] && UBOOT_VERSION=master
rm -rf u-boot
git clone -b ${UBOOT_VERSION} $UBOOT u-boot
cd u-boot
ln -s ../arm-trusted-firmware .
PN=1
for i in ${OURDIR}/device/${TARGET}/u-boot-patches/*.patch ${OURDIR}/device/${TARGET}/u-boot-patches/*.diff; do
        [ -e "$i" ] || continue
        patch -p1 -b -z .p${PN}~ <$i
        PN=$((PN+1))
done
make ${UBOOT_CONFIG}
cat >>.config <<EOF
CONFIG_IDENT_STRING=" OpenMandriva"
CONFIG_SERIAL_PRESENT=y
CONFIG_GZIP=y
CONFIG_CMD_UNZIP=y
EOF
make CROSS_COMPILE=aarch64-linux-gnu- EXTRAVERSION="-OpenMandriva" LDFLAGS="-fuse-ld=bfd" KBUILD_LDFLAGS="-fuse-ld=bfd" HOSTLDFLAGS="-fuse-ld=bfd"
cd ..

cp ${OURDIR}/${ROOTDIR}/boot/vmlinuz-${KERNELVERSION} ${OURDIR}/${ROOTDIR}/boot/zImage
[ -e ${OURDIR}/u-boot/u-boot.bin ] && cp ${OURDIR}/u-boot/u-boot.bin ${OURDIR}/${ROOTDIR}/boot/u-boot.ext
PSEP="$(partitionSeparator ${LOOPDEV})"
ROOTPUUID=$(/sbin/blkid ${LOOPDEV}${PSEP}2 |sed -e 's,.*PARTUUID=",,;s,".*,,')
mkdir -p ${OURDIR}/${ROOTDIR}/boot/extlinux
cat >${OURDIR}/${ROOTDIR}/boot/extlinux/extlinux.conf <<EOF
label OpenMandriva
	kernel /zImage
	fdt /${DTB}.dtb
	append root=PARTUUID=${ROOTPUUID} ${CMDLINE}
EOF
