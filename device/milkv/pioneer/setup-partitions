IMAGE=${OURDIR}/${RESULTDIR}/${BASENAME}.img
dd if=/dev/zero of=${IMAGE} bs=1M count=$((PADDED_EXPECTED_SIZE/1048576))

# Pioneer firmware (EDK2) looks for EFI/BOOT/BOOTRISCV64.EFI on the ESP.
# Mount the ESP at /boot/efi so grub2-mkimage lands in the right place.
PARTITIONS=(":+256M:ef00:vfat:/boot/efi:OMVUEFI")
PARTITIONS+=("::8306:${FSTYPE}:/:OMVROOT")
