# Pioneer U-Boot / LinuxBoot: extlinux on the FAT /boot partition.
# Keep short, stable names -- some of these U-Boot builds are picky about
# VFAT long filenames.
cp -a ${OURDIR}/${ROOTDIR}/boot/vmlinuz-${KERNELVERSION} \
	${OURDIR}/${ROOTDIR}/boot/Image
if [ -e ${OURDIR}/${ROOTDIR}/boot/initrd-${KERNELVERSION}.img ]; then
	cp -a ${OURDIR}/${ROOTDIR}/boot/initrd-${KERNELVERSION}.img \
		${OURDIR}/${ROOTDIR}/boot/initrd.img
fi

FDT=""
if [ -n "$DTB" ]; then
	DTBBASE="$(basename ${DTB}).dtb"
	if [ -e ${OURDIR}/${ROOTDIR}/boot/${DTB}.dtb ]; then
		cp -a ${OURDIR}/${ROOTDIR}/boot/${DTB}.dtb \
			${OURDIR}/${ROOTDIR}/boot/${DTBBASE}
	elif [ -e ${OURDIR}/${ROOTDIR}/boot/dtb-${KERNELVERSION}/${DTB}.dtb ]; then
		cp -a ${OURDIR}/${ROOTDIR}/boot/dtb-${KERNELVERSION}/${DTB}.dtb \
			${OURDIR}/${ROOTDIR}/boot/${DTBBASE}
	fi
	[ -e ${OURDIR}/${ROOTDIR}/boot/${DTBBASE} ] && FDT="/${DTBBASE}"
fi

PSEP="$(partitionSeparator ${LOOPDEV})"
ROOTPUUID=$(/sbin/blkid ${LOOPDEV}${PSEP}2 |sed -e 's,.*PARTUUID=",,;s,".*,,')
if [ -n "$ROOTPUUID" ]; then
	ROOTARG="root=PARTUUID=${ROOTPUUID}"
else
	ROOTARG="root=LABEL=OMVROOT"
fi

mkdir -p ${OURDIR}/${ROOTDIR}/boot/extlinux
{
	echo "default omv"
	echo "menu title OpenMandriva"
	echo "prompt 0"
	echo "timeout 50"
	echo
	echo "label omv"
	echo "	menu label OpenMandriva Lx"
	echo "	linux /Image"
	[ -e ${OURDIR}/${ROOTDIR}/boot/initrd.img ] && echo "	initrd /initrd.img"
	[ -n "$FDT" ] && echo "	fdt ${FDT}"
	echo "	append ${ROOTARG} rw rootwait rootfstype=${FSTYPE} ${CMDLINE}"
	echo
	echo "label omv-text"
	echo "	menu label OpenMandriva Lx (text mode)"
	echo "	linux /Image"
	[ -e ${OURDIR}/${ROOTDIR}/boot/initrd.img ] && echo "	initrd /initrd.img"
	[ -n "$FDT" ] && echo "	fdt ${FDT}"
	echo "	append ${ROOTARG} rw rootwait rootfstype=${FSTYPE} ${CMDLINE} systemd.unit=multi-user.target"
} >${OURDIR}/${ROOTDIR}/boot/extlinux/extlinux.conf
