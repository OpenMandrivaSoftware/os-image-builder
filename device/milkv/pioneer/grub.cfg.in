search --no-floppy --label OMVROOT --set=root
insmod part_gpt
insmod ext2
insmod gzio

set timeout_style=menu
set timeout=10

menuentry 'OpenMandriva Lx' --class openmandriva --class gnu-linux --class gnu --class os {
	linux /boot/vmlinuz-@KVERSION@ root=LABEL=OMVROOT ro rootwait rd.timeout=120 @CMDLINE@
	initrd /boot/initrd-@KVERSION@.img
	@IF_DTB@devicetree /boot/@DTB@.dtb
}

menuentry 'OpenMandriva Lx (text mode)' --class openmandriva --class gnu-linux --class gnu --class os {
	linux /boot/vmlinuz-@KVERSION@ root=LABEL=OMVROOT ro rootwait rd.timeout=120 @CMDLINE@ systemd.unit=multi-user.target
	initrd /boot/initrd-@KVERSION@.img
	@IF_DTB@devicetree /boot/@DTB@.dtb
}

menuentry 'System setup' {
	fwsetup
}
